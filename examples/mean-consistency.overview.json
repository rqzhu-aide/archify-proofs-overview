      }
    },
    {
      "id": "moments",
      "kind": "assumption",
      "label": "Assumption 2",
      "caption": "Finite variance",
      "statement": "$\\mathbb{E}X_i=\\mu$ and $\\operatorname{Var}(X_i)=\\sigma^2<\\infty$.",
      "source": {
        "label": "Assumption 2",
        "start_line": 16,
        "end_line": 18
      }
    },
    {
      "id": "estimator",
      "kind": "definition",
      "label": "Definition 1",
      "caption": "Sample mean",
      "statement": "$\\bar X_n=n^{-1}\\sum_{i=1}^{n}X_i$.",
      "source": {
        "label": "Definition 1",
        "start_line": 19,
        "end_line": 21
      }
    },
    {
      "id": "centering",
      "kind": "lemma",
      "label": "Lemma 1",
      "caption": "Correct centering",
      "statement": "$\\mathbb{E}\\bar X_n=\\mu$.",
      "source": {
        "label": "Lemma 1",
        "start_line": 22,
        "end_line": 24
      }
    },
    {
      "id": "variance",
      "kind": "lemma",
      "label": "Lemma 2",
      "caption": "Vanishing variance",
      "statement": "$\\operatorname{Var}(\\bar X_n)=\\sigma^2/n$.",
      "source": {
        "label": "Lemma 2",
        "start_line": 29,
        "end_line": 31
      }
    },
    {
      "id": "chebyshev",
      "kind": "external_result",
      "label": "Chebyshev",
      "caption": "Probability bound",
      "statement": "For finite-variance $Y$ and $\\varepsilon>0$, $\\Pr(|Y-\\mathbb{E}Y|>\\varepsilon)\\leq\\operatorname{Var}(Y)/\\varepsilon^2$.",
      "source": {
        "label": "Named inequality in the proof of Theorem 1",
        "start_line": 42,
        "end_line": 43
      }
    },
    {
      "id": "bound",
      "kind": "theorem",
      "label": "Theorem 1",
      "caption": "Finite-sample control",
      "statement": "For every $\\varepsilon>0$, $\\Pr(|\\bar X_n-\\mu|>\\varepsilon)\\leq\\sigma^2/(n\\varepsilon^2)$.",
      "source": {
        "label": "Theorem 1",
        "start_line": 37,
        "end_line": 40
      }
    },
    {
      "id": "consistency",
      "kind": "corollary",
      "label": "Corollary 1",
      "caption": "Consistency",
      "statement": "$\\bar X_n\\xrightarrow{p}\\mu$ as $n\\to\\infty$.",
      "source": {
        "label": "Corollary 1",
        "start_line": 47,
        "end_line": 49
      }
    }
  ],
